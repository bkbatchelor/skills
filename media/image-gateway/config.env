# image-gateway saved preferences.
# scripts/generate.sh reads this file. Flags and IMAGE_GATEWAY_* environment
# variables override it per call. Never put the API key itself here.

# Default image model (Gemini API model ID): Nano Banana Pro.
IMAGE_GATEWAY_MODEL=gemini-3-pro-image

# Used automatically when the default keeps failing with 429/5xx after retries
# (only when -m was not passed). Nano Banana 2.1 is about 1/4 the price.
# Leave empty to disable.
IMAGE_GATEWAY_FALLBACK_MODEL=gemini-nano-banana-2.1

# Default output directory. A leading ~ is expanded.
IMAGE_GATEWAY_OUT_DIR=~/Pictures/ai-generated

# Env file that holds GEMINI_API_KEY=... (chmod 600).
IMAGE_GATEWAY_ENV_FILE=~/.config/gemini/.env
