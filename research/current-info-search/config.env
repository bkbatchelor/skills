# current-info-search saved preferences.
# scripts/search.py reads this file on every run. CURRENT_INFO_* environment
# variables override it. Never put the API key itself here.

# Gemini API model ID used for Google Search grounded answers.
CURRENT_INFO_MODEL=gemini-3.8-flash

# Env file that holds GEMINI_API_KEY=... (shared with image-gateway and
# media-transcription). An exported GEMINI_API_KEY takes precedence.
CURRENT_INFO_ENV_FILE=~/.config/gemini/.env

# NotebookLM CLI (notebooklm-py). It signs in with a browser session
# (`notebooklm login`), not with GEMINI_API_KEY.
CURRENT_INFO_NOTEBOOKLM=notebooklm

# Title prefix of the throwaway notebooks the notebook subcommand creates.
CURRENT_INFO_NOTEBOOK_PREFIX=current-info:

# Seconds to wait for NotebookLM web research to finish.
CURRENT_INFO_NOTEBOOK_TIMEOUT=300
