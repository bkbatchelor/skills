# media-transcription saved preferences.
# scripts/transcribe.py reads this file on every run. MEDIA_TRANSCRIPTION_*
# environment variables override it. Never put the API key itself here.

# Speech-to-text model (Gemini API model ID): Gemini 3.5 Transcribe, file/unary variant.
MEDIA_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Text model that writes semantic chapters from the finished transcript.
MEDIA_TRANSCRIPTION_CHAPTER_MODEL=gemini-3.8-flash

# Env file that holds GEMINI_API_KEY=... (shared with image-gateway).
MEDIA_TRANSCRIPTION_ENV_FILE=~/.config/gemini/.env

# The API caps a request at 30 minutes of audio when diarization or word
# timestamps are on. Longer media is split near silences at about this length.
MEDIA_TRANSCRIPTION_CHUNK_SECONDS=1500

# Prices in USD per 1M tokens, Standard paid tier, checked 2026-10-20.
# Used only for the cost estimate in manifest.json.
MEDIA_TRANSCRIPTION_PRICE_IN=2.00
MEDIA_TRANSCRIPTION_PRICE_OUT=12.00
# gemini-3.8-flash: $0.75 / $3.75 through 2026-12-31, then $1.50 / $7.50.
MEDIA_TRANSCRIPTION_CHAPTER_PRICE_IN=0.75
MEDIA_TRANSCRIPTION_CHAPTER_PRICE_OUT=3.75
