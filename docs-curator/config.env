# docs-curator saved preferences.
# scripts/curate.py reads this file on every run. DOCS_CURATOR_* environment
# variables override it.

# Near-duplicate threshold: Jaccard similarity of 5-word shingles at or above
# this makes two text files a proposed duplicate (never pre-accepted).
DOCS_CURATOR_NEAR_SIM=0.90

# The same content in different formats (pptx vs pdf vs md) is matched at this
# lower similarity, since extraction differs a little between formats.
DOCS_CURATOR_CROSS_FORMAT_SIM=0.80

# Files sharing a normalized name stem form a revision family when their text
# similarity (3-word shingles) is at or above this. Files linked by a git
# rename use half of it.
DOCS_CURATOR_FAMILY_SIM=0.50

# Text files shorter than this many words are not matched as near-duplicates.
DOCS_CURATOR_MIN_WORDS=12

# Which copy to keep among duplicates, after source priority:
# '>' separates ranks (best first), '=' joins equals. Formats not listed rank last.
DOCS_CURATOR_FORMAT_RANK=md=txt=html=csv>pptx=docx=xlsx=ppt=doc=xls>pdf>image

# Environment/region tokens in paths. Config files are only compared with files
# of the same logical path and the same scope. Regions (us-east-1) and tenant-*
# are always recognised.
DOCS_CURATOR_SCOPE_TOKENS=dev,development,test,qa,staging,stage,uat,prod,production,local

# At most this many review packets are written; the rest are listed as unreviewed.
DOCS_CURATOR_PACKET_CAP=200

# Characters of each file's start searched for DEPRECATED / SUPERSEDED markers.
DOCS_CURATOR_MARKER_CHARS=3000

# Characters of each file quoted in a review packet.
DOCS_CURATOR_EXCERPT_CHARS=1500

# Rows kept per xlsx sheet or csv file when converting to Markdown.
DOCS_CURATOR_XLSX_ROW_CAP=200

# 1 = run tesseract on images and scanned PDFs. Image text is only used to
# find duplicate images; scanned PDFs get their text from it.
DOCS_CURATOR_OCR=0

# Seconds before a soffice conversion of a legacy .doc/.xls/.ppt is abandoned.
DOCS_CURATOR_SOFFICE_TIMEOUT=120
