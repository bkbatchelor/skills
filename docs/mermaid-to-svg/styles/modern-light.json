  "themeCSS": ".node rect,.node polygon,.node path,.node circle,.node ellipse{stroke-width:1.5px;}.node rect{rx:8px;ry:8px;}.cluster rect{rx:12px;ry:12px;stroke-width:1px;stroke-dasharray:6 6;stroke:#cbd5e1;}.edgePath .path,.flowchart-link{stroke-width:1.5px;}.edgeLabel,.edgeLabel p,.edgeLabel span{background-color:#f4f5f7;font-weight:500;}.edgeLabel rect{fill:#f4f5f7;opacity:1;}.label,.nodeLabel,.edgeLabel{font-weight:500;}.row-rect-odd path,.row-rect-odd rect{fill:#ffffff !important;}.row-rect-even path,.row-rect-even rect{fill:#f1f5f9 !important;}"
