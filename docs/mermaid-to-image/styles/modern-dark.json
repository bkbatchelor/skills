  "themeCSS": ".node rect,.node polygon,.node path,.node circle,.node ellipse{stroke-width:1.5px;}.node rect{rx:8px;ry:8px;}.cluster rect{rx:12px;ry:12px;stroke-width:1px;stroke-dasharray:6 6;stroke:#334155;}.edgePath .path,.flowchart-link{stroke-width:1.5px;}.edgeLabel,.edgeLabel p,.edgeLabel span{background-color:#020617;font-weight:500;}.edgeLabel rect{fill:#020617;opacity:1;}.label,.nodeLabel,.edgeLabel{font-weight:500;}.row-rect-odd path,.row-rect-odd rect{fill:#0b1a2e !important;}.row-rect-even path,.row-rect-even rect{fill:#07111f !important;}"
